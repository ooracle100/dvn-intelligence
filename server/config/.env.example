# LayerZero Scan API Key (if required in future)
LZ_SCAN_API_KEY=your_api_key_here

# CoinGecko API Key (optional, for higher rate limits)
COINGECKO_API_KEY=your_api_key_here

# CoinMarketCap API Key (fallback price oracle)
CMC_API_KEY=your_api_key_here

# Database Configuration
DATABASE_PATH=./data/dvn_intelligence.db

# Backfill Configuration
BACKFILL_MONTHS=6
BACKFILL_BATCH_SIZE=100
BACKFILL_RATE_LIMIT_MS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./server/logs/backfill.log
