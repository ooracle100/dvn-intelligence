// utils/dvn.js Artf4
// DVN scoring and analytics utilities

import { parseAmount } from './format';
import { normalizeStackName } from './normalize';

/**
 * Summarize DVN-specific statistics
 * @param {Array} txs - Array of transactions involving this DVN
 * @param {string} address - DVN address
 * @returns {object} DVN statistics
 */
export function summarizeDvn(txs, address) {
  const total = txs.length;
  const delivered_txs = txs.filter(t => 
    (t.delivery_status || '').toLowerCase() === 'delivered'
  );
  const failed = total - delivered_txs.length;
  
  const volume_secured = delivered_txs.reduce((s, t) => 
    s + parseAmount(t.amount_usd, t.amount_tokens), 0
  );
  
  const undelivered_volume = txs.reduce((s, t) => 
    (t.delivery_status || '').toLowerCase() === 'delivered' 
      ? s 
      : s + parseAmount(t.amount_usd, t.amount_tokens), 
    0
  );
  
  const successRate = Math.round((delivered_txs.length / Math.max(1, total)) * 100);
  
  const avgLatency = delivered_txs.length 
    ? Number((delivered_txs.reduce((s, t) => 
        s + Number(t.latency_seconds || 0), 0) / delivered_txs.length
      ).toFixed(1))
    : null;
  
  return { 
    address, 
    total, 
    volume_secured, 
    undelivered_volume, 
    failed, 
    successRate, 
    avgLatency 
  };
}

/**
 * Summarize generic transaction statistics
 * @param {Array} txs - Array of transactions
 * @returns {object} Transaction statistics
 */
export function summarizeTransactions(txs) {
  const total = txs.length;
  const volume = txs.reduce((s, t) => 
    s + parseAmount(t.amount_usd, t.amount_tokens), 0
  );
  
  const failed = txs.filter(t => 
    (t.delivery_status || '').toLowerCase() !== 'delivered'
  ).length;
  
  const successRate = Math.round(((total - failed) / Math.max(1, total)) * 100);
  
  const delivered = txs.filter(t => 
    (t.delivery_status || '').toLowerCase() === 'delivered'
  );
  
  const avgLatency = delivered.length 
    ? Number((delivered.reduce((s, t) => 
        s + Number(t.latency_seconds || 0), 0) / Math.max(1, delivered.length)
      ).toFixed(1))
    : null;
  
  return { total, volume, failed, successRate, avgLatency };
}

/**
 * Summarize stack performance across transactions
 * @param {object} data - Dataset with transactions array
 * @returns {Array} Array of stack performance objects
 */
export function summarizeStacks(data) {
  const map = {};
  
  (data?.transactions || []).forEach(tx => {
    const raw = tx?.dvn_stack_names || 'unknown';
    const name = normalizeStackName(raw);
    
    map[name] = map[name] || {
      name,
      count: 0,
      total_volume: 0,
      delivered_volume: 0,
      failed: 0,
      latencySumDelivered: 0,
      deliveredCount: 0
    };

    const amt = parseAmount(tx.amount_usd, tx.amount_tokens);
    map[name].count += 1;
    map[name].total_volume += amt;

    if ((tx.delivery_status || '').toLowerCase() === 'delivered') {
      map[name].delivered_volume += amt;
      map[name].latencySumDelivered += Number(tx.latency_seconds || 0);
      map[name].deliveredCount += 1;
    } else {
      map[name].failed += 1;
    }
  });

  return Object.values(map)
    .map(m => ({
      ...m,
      avgLatency: m.deliveredCount > 0 
        ? Number((m.latencySumDelivered / m.deliveredCount).toFixed(1)) 
        : null,
      successRate: Math.round(((m.count - m.failed) / Math.max(1, m.count)) * 100),
      displayName: (data?.metadata?.dvn_labels || {})[String(m.name).toLowerCase()] || null
    }))
    .sort((a, b) => 
      (b.delivered_volume || 0) - (a.delivered_volume || 0) || 
      b.successRate - a.successRate
    );
}

//part2
// utils/dvn.js (Part 2)
// OAPP summaries and DVN scoring
/**
 * Summarize OAPP performance and extract top stacks
 * @param {object} data - Dataset with transactions array
 * @returns {Array} Array of OAPP performance objects
 */
export function summarizeOapps(data) {
  const map = {};
  
  (data?.transactions || []).forEach(tx => {
    const name = tx?.oapp_name || 'unknown';
    map[name] = map[name] || { 
      name, 
      address: tx?.oapp_address || '', 
      count: 0, 
      volume: 0, 
      transactions: [], 
      routes: new Set(), 
      delivered_volume: 0, 
      undelivered_volume: 0, 
      delivered_count: 0, 
      failed_count: 0 
    };
    
    map[name].count += 1;
    map[name].volume += parseAmount(tx.amount_usd, tx.amount_tokens);
    map[name].transactions.push(tx);
    
    const route = tx?.oapp_chain || 
      (tx?.source_chain && tx?.destination_chain 
        ? `${tx.source_chain}-${tx.destination_chain}` 
        : 'unknown');
    map[name].routes.add(route);
    
    if ((tx.delivery_status || '').toLowerCase() === 'delivered') {
      map[name].delivered_volume += parseAmount(tx.amount_usd, tx.amount_tokens);
      map[name].delivered_count += 1;
    } else {
      map[name].undelivered_volume += parseAmount(tx.amount_usd, tx.amount_tokens);
      map[name].failed_count += 1;
    }
  });

  const results = Object.values(map).map(o => {
    const deliveredTxs = o.transactions.filter(t => 
      (t.delivery_status || '').toLowerCase() === 'delivered'
    );
    
    const avgLatency = deliveredTxs.length 
      ? Number((deliveredTxs.reduce((s, t) => 
          s + Number(t.latency_seconds || 0), 0) / Math.max(1, deliveredTxs.length)
        ).toFixed(1))
      : null;
    
    const successRate = Math.round((o.delivered_count / Math.max(1, o.count)) * 100);
    const primaryRoute = Array.from(o.routes)[0] || 'unknown';

    // Stack teaser: compute delivered_volume per normalized stack for this OAPP
    const stackMap = {};
    o.transactions.forEach(t => {
      const stack = normalizeStackName(t.dvn_stack_names || 'unknown');
      stackMap[stack] = stackMap[stack] || { name: stack, delivered_volume: 0, count: 0 };
      stackMap[stack].count += 1;
      if ((t.delivery_status || '').toLowerCase() === 'delivered') {
        stackMap[stack].delivered_volume += parseAmount(t.amount_usd, t.amount_tokens);
      }
    });
    
    const topStacks = Object.values(stackMap)
      .sort((a, b) => (b.delivered_volume || 0) - (a.delivered_volume || 0))
      .slice(0, 2)
      .map(s => s.name);

    return { ...o, primaryRoute, avgLatency, successRate, topStacks };
  });

  return results.sort((a, b) => b.delivered_volume - a.delivered_volume);
}

/**
 * Score DVNs based on performance metrics
 * @param {object} data - Dataset with transactions array
 * @param {string} mode - Scoring mode: 'balanced', 'volume_first', or 'simple'
 * @returns {Array} Array of DVN score objects
 */
export function scoreDvns(data, mode = 'balanced') {
  const map = {};
  
  (data?.transactions || []).forEach(tx => {
    const addrs = (tx.required_dvn_addresses || []).concat(tx.optional_dvn_addresses || []);
    const amt = parseAmount(tx.amount_usd, tx.amount_tokens);
    
    if (addrs.length === 0) {
      const key = (tx?.dvn_name || normalizeStackName(tx?.dvn_stack_names) || 'unknown').toString();
      map[key] = map[key] || {
        name: key,
        count: 0,
        total_volume: 0,
        delivered_volume: 0,
        undelivered_volume: 0,
        delivered_count: 0,
        total_latency: 0,
        failed: 0,
        displayName: null
      };
      
      map[key].count += 1;
      map[key].total_volume += amt;
      
      if ((tx.delivery_status || '').toLowerCase() === 'delivered') {
        map[key].delivered_volume += amt;
        map[key].delivered_count += 1;
        map[key].total_latency += Number(tx.latency_seconds || 0);
      } else {
        map[key].undelivered_volume += amt;
        map[key].failed += 1;
      }
      
      if (!map[key].displayName && tx?.dvn_name) map[key].displayName = tx.dvn_name;
    } else {
      addrs.forEach(aRaw => {
        const a = String(aRaw || 'unknown').toLowerCase();
        map[a] = map[a] || {
          name: a,
          count: 0,
          total_volume: 0,
          delivered_volume: 0,
          undelivered_volume: 0,
          delivered_count: 0,
          total_latency: 0,
          failed: 0,
          displayName: null
        };
        
        map[a].count += 1;
        map[a].total_volume += amt;
        
        if ((tx.delivery_status || '').toLowerCase() === 'delivered') {
          map[a].delivered_volume += amt;
          map[a].delivered_count += 1;
          map[a].total_latency += Number(tx.latency_seconds || 0);
        } else {
          map[a].undelivered_volume += amt;
          map[a].failed += 1;
        }
        
        if (!map[a].displayName && tx?.dvn_name) map[a].displayName = tx.dvn_name;
      });
    }
  });

  // Convert to array and compute derived metrics
  const arr = Object.values(map).map(m => {
    const avgLatency = m.delivered_count ? (m.total_latency / m.delivered_count) : null;
    const successRate = Math.round(((m.count - m.failed) / Math.max(1, m.count)) * 100);
    return {
      ...m,
      avgLatency,
      successRate
    };
  });

  // Normalization denominators
  const maxDeliveredVolume = Math.max(1, ...arr.map(a => a.delivered_volume || 0));
  const maxCount = Math.max(1, ...arr.map(a => a.count || 0));
  const maxUndeliveredVolume = Math.max(1, ...arr.map(a => a.undelivered_volume || 0));
  const maxLatency = Math.max(1, ...arr.map(a => a.avgLatency || 0));

  // Scoring
  const scored = arr.map(a => {
    const volScore = (a.delivered_volume || 0) / maxDeliveredVolume;
    const countScore = (a.count || 0) / maxCount;
    const undelPenalty = (a.undelivered_volume || 0) / maxUndeliveredVolume;
    const latencyPenalty = a.avgLatency ? (a.avgLatency / maxLatency) : 0;
    const successScore = (a.successRate || 0) / 100;

    let rawScore = 0;
    if (mode === 'volume_first') {
      rawScore = volScore * 0.6 + successScore * 0.2 + countScore * 0.1 - undelPenalty * 0.05 - latencyPenalty * 0.05;
    } else if (mode === 'simple') {
      rawScore = successScore;
    } else {
      rawScore = volScore * 0.45 + countScore * 0.25 + successScore * 0.2 - undelPenalty * 0.06 - latencyPenalty * 0.04;
    }

    const scaled = Math.max(20, Math.round(rawScore * 100));
    return { ...a, score: scaled };
  });

  // Attach labels
  const labelsMeta = (data?.metadata?.dvn_labels || {});
  const labelsRoot = (data?.dvn_labels || {});
  const labels = { ...labelsMeta, ...labelsRoot };

  return scored
    .map(s => ({
      ...s,
      displayName: labels[String(s.name).toLowerCase()] || s.displayName || null
    }))
    .sort((a, b) => b.score - a.score);
}