// src/utils/lzscanApi.js
import { CHAIN_INFO, getDVNName } from './dvnRegistry';
import { getDVNAddresses } from './dvnRegistry';
import { getAssetDisplayName, isKnownOFT } from './assetRegistry';

const LZSCAN_API = "https://scan.layerzero-api.com/v1";
const ETHERSCAN_KEY = process.env.REACT_APP_ETHERSCAN_API_KEY || "";
const COINGECKO_API = "https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd";

// All LayerZero chain IDs
const CHAIN_EIDS = Object.keys(CHAIN_INFO).map(Number);

// Cache
const CACHE_KEY = 'dvn_realtime_cache';
const CACHE_TTL = 1000 * 60 * 60; // 1 hour

function getCache() {
  try {
    return JSON.parse(localStorage.getItem(CACHE_KEY) || '{}');
  } catch { return {}; }
}

function setCache(key, value) {
  const cache = getCache();
  cache[key] = { value, expiry: Date.now() + CACHE_TTL };
  localStorage.setItem(CACHE_KEY, JSON.stringify(cache));
}

function getCached(key) {
  const cache = getCache();
  const item = cache[key];
  if (!item || Date.now() > item.expiry) return null;
  return item.value;
}

// Main search function
export async function searchTransaction(query) {
  const q = query.trim().toLowerCase();
  
  // Check if it's a DVN name
  const dvnInfo = getDVNAddresses(q);
  if (dvnInfo) {
    // Return properly formatted response
    return {
      type: "dvn_name",
      name: dvnInfo.name,
      addresses: dvnInfo.addresses,
      message: `Found ${dvnInfo.name}. Search using one of its addresses.`
    };
  }
  
  // TX hash
  if (q.startsWith('0x') && q.length === 66) {
    return await fetchByTxHash(q);
  }
  
  // Address
  if (q.startsWith('0x') && q.length === 42) {
    return await fetchByAddress(q);
  }
  
  return { error: "Invalid format. Use: tx hash, address, or DVN name (e.g., 'Deutsche Telekom')" };
}

// Fetch by transaction hash
async function fetchByTxHash(txHash) {
  const cacheKey = `tx:${txHash}`;
  const cached = getCached(cacheKey);
  if (cached) return cached;
  
  try {
    const res = await fetch(`${LZSCAN_API}/messages/tx/${txHash}`);
    const data = await res.json();
    console.log(data, " Full API response"); // Debug log

    if (!data.data || data.data.length === 0) {
      return { error: "Transaction not found on LayerZeroScan" };
    }
    console.log(data.data[0], " Debug log" ); // Debug log
    const parsed = parseTransaction(data.data[0]);
    
    // Enrich with asset name
    parsed.oapp_display_name = getAssetDisplayName(parsed.oapp_address, parsed.source_chain_eid) || parsed.oapp_name;
    parsed.is_known_oft = isKnownOFT(parsed.oapp_address);
    
    // Enrich with fees
    parsed.fees = await enrichFees(parsed);
    
    setCache(cacheKey, parsed);
    return parsed;
    
  } catch (error) {
    console.error('fetchByTxHash error:', error);
    return { error: "Failed to fetch transaction" };
  }
}

// Fetch by address (OAPP/DVN/Wallet)
async function fetchByAddress(address) {
  console.log(`Fetching by address: ${address}`);
  const cacheKey = `addr:${address}`;
  const cached = getCached(cacheKey);
  if (cached) return cached;
  
  try {
    // Search across all chains in parallel
    const results = await Promise.all(
      CHAIN_EIDS.map(async (eid) => {
        try {
          const res = await fetch(`${LZSCAN_API}/messages/oapp/${eid}/${address}?limit=50`);
          const data = await res.json();
          return data.data || [];
        } catch {
          return [];
        }
      })
    );
    
    const allTxs = results.flat().map(msg => {
      const tx = parseTransaction(msg);
      
      // Enrich with asset name
      tx.oapp_display_name = getAssetDisplayName(tx.oapp_address, tx.source_chain_eid) || tx.oapp_name;
      tx.is_known_oft = isKnownOFT(tx.oapp_address);
      
      return tx;
    });
    
    if (allTxs.length === 0) {
      return { error: "No transactions found for this address" };
    }
    
    const response = {
      type: "address",
      address,
      display_name: getAssetDisplayName(address) || null,
      is_known_oft: isKnownOFT(address),
      transactions: allTxs,
      total: allTxs.length
    };
    
    setCache(cacheKey, response);
    return response;
    
  } catch (error) {
    console.error('fetchByAddress error:', error);
    return { error: "Failed to search address" };
  }
}

// Parse LayerZero message
function parseTransaction(msg) {
  const src = msg.source?.tx || {};
  const dst = msg.destination?.tx || {};
  const pathway = msg.pathway || {};
  const config = msg.config?.outboundConfig || {};
  
  // Get chain EID from pathway
  const srcChainEid = pathway.sender?.chainId;
  const dstChainEid = pathway.receiver?.chainId;
  
  // Get DVN names
  const requiredDvns = config.requiredDVNs || [];
  const optionalDvns = config.optionalDVNs || [];
  
  const requiredDvnNames = requiredDvns.map(addr => {
  // Try source chain first, then try all chains
  let name = getDVNName(addr, srcChainEid);
  if (!name || name === addr.slice(0, 10) + '...') {
    // Try Ethereum mainnet (30101) as fallback
    name = getDVNName(addr, 30101);
  }
  return name || addr.slice(0, 10) + '...';
});
  const optionalDvnNames = optionalDvns.map(addr => {
  // Try source chain first, then try all chains
  let name = getDVNName(addr, srcChainEid);
  if (!name || name === addr.slice(0, 10) + '...') {
    // Try Ethereum mainnet (30101) as fallback
    name = getDVNName(addr, 30101);
  }
  return name || addr.slice(0, 10) + '...';
});

  return {
    source_tx_hash: src.txHash,
    source_block: src.blockNumber,
    source_timestamp: src.blockTimestamp ? new Date(src.blockTimestamp * 1000).toISOString() : null,
    source_chain: pathway.sender?.chain || CHAIN_INFO[srcChainEid]?.name,
    source_chain_name: pathway.sender?.chain || CHAIN_INFO[srcChainEid]?.name,
    source_chain_eid: srcChainEid,
    
    destination_tx_hash: dst.txHash,
    destination_block: dst.blockNumber,
    destination_timestamp: dst.blockTimestamp ? new Date(dst.blockTimestamp * 1000).toISOString() : null,
    destination_chain: pathway.receiver?.chain || CHAIN_INFO[dstChainEid]?.name,
    destination_chain_name: pathway.receiver?.chain || CHAIN_INFO[dstChainEid]?.name,
    destination_chain_eid: dstChainEid,
    
    oapp_address: pathway.sender?.address,
    oapp_name: pathway.sender?.name,
    
    message_guid: msg.guid,
    
    required_dvn_addresses: requiredDvns,
    optional_dvn_addresses: optionalDvns,
    required_dvn_names: requiredDvnNames,
    optional_dvn_names: optionalDvnNames,
    dvn_stack_names: [
      ...requiredDvnNames.map(n => `${n} (Required)`),
      ...optionalDvnNames.map(n => `${n} (Optional)`)
    ].join(' + '),
    
    delivery_status: dst.txHash ? "DELIVERED" : "SENT",
    
    latency_seconds: (dst.blockTimestamp && src.blockTimestamp) 
      ? dst.blockTimestamp - src.blockTimestamp 
      : null,
    
    performance_category: dst.txHash 
      ? (dst.blockTimestamp - src.blockTimestamp <= 120 ? "Fast (<2min)" : "Slow (>2min)")
      : "Undelivered",
    
    // Placeholder for amounts (LayerZeroScan doesn't provide these)
    amount_tokens: null,
    amount_usd: 0
  };
}

// Enrich with fees using multi-chain Etherscan API
async function enrichFees(tx) {
  if (!ETHERSCAN_KEY) {
    return { available: false, reason: "No API key" };
  }
  
  // Use source tx for fees
  const txHash = tx.source_tx_hash;
  const chainEid = tx.source_chain_eid;
  
  if (!txHash || !chainEid) {
    return { available: false, reason: "Missing tx data" };
  }
  
  const chainInfo = CHAIN_INFO[chainEid];
  if (!chainInfo) {
    return { available: false, reason: "Unsupported chain" };
  }
  
  const cacheKey = `fees:${txHash}`;
  const cached = getCached(cacheKey);
  if (cached) return cached;
  
  try {
    // Get transaction receipt
    const url = `${chainInfo.explorer}?module=proxy&action=eth_getTransactionReceipt&txhash=${txHash}&apikey=${ETHERSCAN_KEY}`;
    const res = await fetch(url);
    const data = await res.json();
    
    if (!data.result) {
      return { available: false, reason: "Receipt not found" };
    }
    
    const receipt = data.result;
    const gasUsed = parseInt(receipt.gasUsed, 16);
    const effectiveGasPrice = parseInt(receipt.effectiveGasPrice || receipt.gasPrice, 16);
    
    const feeWei = gasUsed * effectiveGasPrice;
    const feeEth = Number(feeWei) / 1e18;
    
    // Get ETH price
    const priceRes = await fetch(COINGECKO_API);
    const priceData = await priceRes.json();
    const ethPrice = priceData.ethereum?.usd || 3500;
    
    const feeUsd = feeEth * ethPrice;
    
    const fees = {
      available: true,
      chain_fee_eth: feeEth.toFixed(9),
      chain_fee_usd: feeUsd.toFixed(2),
      eth_price_usd: ethPrice,
      gas_used: gasUsed,
      gas_price_gwei: (effectiveGasPrice / 1e9).toFixed(2)
    };
    
    setCache(cacheKey, fees);
    return fees;
    
  } catch (error) {
    console.error('enrichFees error:', error);
    return { available: false, reason: "API error" };
  }
}